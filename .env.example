# Connexion PostgreSQL (sans elle, une base en mémoire est utilisée en développement)
DATABASE_URL=postgres://user:motdepasse@localhost:5432/restaurant
# Mettre à true pour une base externe qui exige SSL
PGSSL=false

# Secret de signature des sessions (obligatoire en production)
JWT_SECRET=changez-moi-par-une-longue-chaine-aleatoire

# Compte propriétaire créé au tout premier démarrage
OWNER_USERNAME=proprietaire
OWNER_PASSWORD=un-mot-de-passe-solide

# Valeurs par défaut des paramètres (modifiables ensuite dans l'application)
RESTAURANT_NAME=La Belle Table
CURRENCY=FCFA

# true = ajoute une carte, un stock et un compte gérant de démonstration
SEED_DEMO=false
